# =============================================================================
# Optical Quality — Variables de entorno
# =============================================================================
# Copia este archivo como `.env.local` y pega tus valores reales.
# En Next.js, `.env.local` no se sube a git (ya está en .gitignore).
#
#   cp .env.example .env.local
#
# IMPORTANTE:
# - Variables con prefijo NEXT_PUBLIC_ son visibles en el navegador.
# - Las demás solo deben usarse en Server Components, Route Handlers o API Routes.
# - NUNCA expongas SUPABASE_SERVICE_ROLE_KEY ni CLOUDINARY_API_SECRET al cliente.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — Base de datos y auth
# -----------------------------------------------------------------------------

# Project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public (Dashboard → Project Settings → API → Project API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# service_role — SOLO servidor (misma pantalla, clave service_role)
# Usar para operaciones admin, bypass RLS, jobs en backend, etc.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# Cloudinary — Almacenamiento de archivos (imágenes, PDFs, etc.)
# -----------------------------------------------------------------------------

# Cloud name (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=tu_cloud_name

# API Key (Dashboard → Account Details → API Key)
CLOUDINARY_API_KEY=123456789012345

# API Secret — SOLO servidor (misma sección, botón revelar secret)
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456


# -----------------------------------------------------------------------------
# Opcional — Cloudinary en cliente (solo si usas upload preset unsigned)
# -----------------------------------------------------------------------------
# Si más adelante subes archivos directo desde el browser con preset unsigned,
# descomenta y usa el cloud name también en el cliente:
#
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset
